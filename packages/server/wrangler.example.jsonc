// Copy to wrangler.jsonc (git-ignored) and fill in your own values. Secrets go in .deploy.vars, not here.
{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "website-chatbot",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-01",
  "rules": [{ "type": "Text", "globs": ["**/*.md"], "fallthrough": true }],
  // The address the widget, inbox (/admin) and Playground are served from. Remove to use workers.dev instead.
  "routes": [{ "pattern": "chatbot.example.com", "custom_domain": true }],
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/admin/api/*"]
  },
  "durable_objects": {
    "bindings": [
      { "name": "CHAT_ROOM", "class_name": "ChatRoom" },
      { "name": "HUB", "class_name": "Hub" }
    ]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["ChatRoom", "Hub"] }],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "website-chatbot",
      // From `npx wrangler d1 create website-chatbot`.
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  "triggers": { "crons": [] },
  "observability": { "enabled": true },
  "vars": {
    "OMNARA_API": "https://api.omnara.com/v1",
    // Your Omnara organisation and the project that holds the chatbot's agents and knowledge stores.
    "OMNARA_ORG_ID": "org_...",
    "OMNARA_PROJECT_ID": "proj_...",
    "PUBLIC_URL": "https://chatbot.example.com",
    // Cloudflare Access protecting /admin and /playground: your team domain and the application's AUD tag.
    "ACCESS_TEAM_DOMAIN": "your-team.cloudflareaccess.com",
    "ACCESS_AUD": "",
    // Domain for reply-by-email addresses (chat+<tag>@...); empty turns replies by email off. Sites can override it.
    "REPLY_DOMAIN": "",
    "DEV_MODE": "0"
  }
}
